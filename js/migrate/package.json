{
  "name": "@riverqueue/migrate",
  "version": "0.2.0",
  "description": "Canonical River database migrations for JavaScript and TypeScript.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../node_modules/typescript/bin/tsc && node ../scripts/copy-license.mjs",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build",
    "test": "vitest run --passWithNoTests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riverqueue/river.git",
    "directory": "js/migrate"
  },
  "contributors": [
    "Brandur Leach",
    "Blake Gentry"
  ],
  "license": "MPL-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@types/node": ">=26",
    "riverqueue": "workspace:0.2.0"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@riverqueue/driver-pg": "workspace:0.2.0",
    "@types/node": "^26.1.1",
    "pg": "^8.22.0",
    "riverqueue": "workspace:0.2.0"
  },
  "keywords": [
    "river",
    "job-queue",
    "migrations",
    "postgresql",
    "sqlite"
  ]
}
