{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "application_name": {
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9._-]+$",
      "type": "string"
    },
    "command": {
      "items": { "minLength": 1, "type": "string" },
      "minItems": 1,
      "type": "array"
    },
    "implementation": {
      "pattern": "^[a-z][a-z0-9_-]*$",
      "type": "string"
    },
    "release_command": {
      "items": { "minLength": 1, "type": "string" },
      "minItems": 1,
      "type": "array"
    },
    "restart_command": {
      "items": { "minLength": 1, "type": "string" },
      "minItems": 1,
      "type": "array"
    },
    "version": { "minLength": 1, "type": "string" }
  },
  "required": ["application_name", "command", "implementation"],
  "title": "River conformance candidate descriptor",
  "type": "object"
}
