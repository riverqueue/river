    def job_get_by_id: (untyped) -> untyped
    def job_insert_many: (Array[JobInsertParams]) -> Array[[River::JobRow, bool]]

    private

    def mysql_columns: (String) -> String
    def mysql_delete: (String, String, String, ?limit: untyped) -> untyped
